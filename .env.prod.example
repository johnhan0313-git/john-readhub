# Portainer Stack 环境变量（均可选；不填则使用 compose 默认值）

# --- 构建 frontend 必填（GitHub Packages: @johnhan0313-git/shared）---
# Personal Access Token，需勾选 read:packages
# Portainer Stack 环境变量请填 GH_PACKAGES_TOKEN（勿用 GITHUB_TOKEN，易与 Portainer 拉 Git 凭据冲突）
GH_PACKAGES_TOKEN=
# GITHUB_TOKEN=   # 旧名，仍兼容；新部署请改用 GH_PACKAGES_TOKEN

# --- 建议按需填写 ---
NEWSAPI_KEY=
GNEWS_API_KEY=
SCRAPER_BOSS_COOKIE=
SCRAPER_MAIMAI_COOKIE=
AI_LLM_API_KEY=

# --- 代理（compose 已有默认值，一般不用改）---
# john-server 外网走宿主机 mihomo；Portainer 拉 GitHub 需在 Portainer 容器单独配（见 docs/PORTAINER_DEPLOY.md）
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890

# --- 一般不用改 ---
# FETCH_INTERVAL_MINUTES=30
# RSS_FETCH_INTERVAL_MINUTES=15
# SCRAPER_FETCH_INTERVAL_MINUTES=120
