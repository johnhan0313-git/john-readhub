DATABASE_URL=sqlite:///./data/readhub.db
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Third-party news APIs (optional — RSS sources work without keys)
NEWSAPI_KEY=
GNEWS_API_KEY=

# Scheduler
FETCH_INTERVAL_MINUTES=30
RSS_FETCH_INTERVAL_MINUTES=15
ARTICLE_RETENTION_DAYS=90
RUN_FETCH_ON_STARTUP=true

# Phase 2: AI event clustering (optional)
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
