DATABASE_URL=postgresql+psycopg://readhub:readhub-123@localhost:5432/readhub
# 本地经 Tailscale 连 john-server 测试库（需 john-server:5432 可达）:
# DATABASE_URL=postgresql+psycopg://readhub:readhub-123@john-server:5432/readhub-test
# Docker 内连 john-postgresql:
# DATABASE_URL=postgresql+psycopg://readhub:readhub-123@john-postgresql:5432/readhub
USE_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ADMIN_TOKEN=change-me

# Third-party news APIs (optional — RSS sources work without keys)
NEWSAPI_KEY=
GNEWS_API_KEY=

# Scheduler
FETCH_INTERVAL_MINUTES=30
RSS_FETCH_INTERVAL_MINUTES=15
ARTICLE_RETENTION_DAYS=90
RUN_FETCH_ON_STARTUP=true

# Job scrapers (Playwright + optional cookies)
SCRAPER_FETCH_INTERVAL_MINUTES=120
# 从 curl 的 -b '...' 整段粘贴，分号分隔，无引号
SCRAPER_BOSS_COOKIE=
SCRAPER_MAIMAI_COOKIE=
